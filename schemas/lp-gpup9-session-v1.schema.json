{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "block",
    "group",
    "family",
    "endpoint",
    "config",
    "position",
    "count",
    "setup_ns",
    "teardown_ns",
    "complete_session_ns",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "gpup9-session"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]+$"
    },
    "block": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "group": {
      "type": "string",
      "pattern": "^(admission|screening|validation|holdout)-[a-z]+-[0-9]+$"
    },
    "family": {
      "enum": [
        "small-33",
        "sparse-128",
        "generic-1024",
        "generic-2048",
        "coupled-1024",
        "coupled-2048"
      ]
    },
    "endpoint": {
      "enum": [
        "prepared",
        "cold"
      ]
    },
    "config": {
      "type": "string",
      "pattern": "^(native|fp4x2)-w(16|32)-s[01]$"
    },
    "position": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "count": {
      "enum": [
        1,
        4,
        32
      ]
    },
    "setup_ns": {
      "type": "integer",
      "minimum": 0
    },
    "teardown_ns": {
      "type": "integer",
      "minimum": 0
    },
    "complete_session_ns": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "scenario",
          "result",
          "model",
          "certified",
          "complete_ns",
          "solve_ns",
          "physical",
          "logical",
          "attempted",
          "gpu_us",
          "costs_ns",
          "final_lane",
          "recoveries"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "scenario": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^artifacts/gpup9-v1/[a-zA-Z0-9_./-]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^artifacts/gpup9-v1/[a-zA-Z0-9_./-]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "certified": {
            "type": "boolean"
          },
          "complete_ns": {
            "type": "integer",
            "minimum": 1
          },
          "solve_ns": {
            "type": "integer",
            "minimum": 1
          },
          "physical": {
            "type": "integer",
            "minimum": 0
          },
          "logical": {
            "type": "integer",
            "minimum": 0
          },
          "attempted": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "32",
                "34",
                "36"
              ]
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "gpu_us": {
            "type": "number",
            "minimum": 0
          },
          "costs_ns": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "audit",
                "checker",
                "coordination",
                "export",
                "initial_audit",
                "iteration",
                "prepare_reset",
                "checkpoint",
                "rollback",
                "conversion"
              ]
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "final_lane": {
            "enum": [
              32,
              34,
              36
            ]
          },
          "recoveries": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lp-gpup9-session-v1.schema.json",
  "title": "GPUP-9 complete session version 1"
}
