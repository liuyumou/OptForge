{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lp-endpoint-v5.schema.json",
  "title": "Adaptive LP endpoint v5",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 5
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requested_backend": {
      "const": "cuda-lp-tuned"
    },
    "record": {
      "anyOf": [
        {
          "$ref": "solve-record-v2.schema.json"
        },
        {
          "$ref": "solve-record-v5.schema.json"
        }
      ]
    },
    "row_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "const": true
        },
        "profile": {
          "type": "boolean"
        },
        "device_buffer_limit_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "dual": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "iterations": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "assessment_iteration": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "restarts": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "kernel_launches": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "device_buffer_peak_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "phases_ns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_preparation": {
              "type": "integer",
              "minimum": 0
            },
            "device_context": {
              "type": "integer",
              "minimum": 0
            },
            "preparation": {
              "type": "integer",
              "minimum": 0
            },
            "preconditioning": {
              "type": "integer",
              "minimum": 0
            },
            "invariant_allocation_upload": {
              "type": "integer",
              "minimum": 0
            },
            "working_allocation": {
              "type": "integer",
              "minimum": 0
            },
            "working_upload": {
              "type": "integer",
              "minimum": 0
            },
            "kernels_and_synchronization": {
              "type": "integer",
              "minimum": 0
            },
            "readback": {
              "type": "integer",
              "minimum": 0
            },
            "iteration": {
              "type": "integer",
              "minimum": 0
            },
            "host_checks": {
              "type": "integer",
              "minimum": 0
            },
            "solve_record_serialization": {
              "type": "integer",
              "minimum": 0
            },
            "native_preparation": {
              "type": "integer",
              "minimum": 0
            },
            "native_solve": {
              "type": "integer",
              "minimum": 0
            },
            "native_extraction": {
              "type": "integer",
              "minimum": 0
            },
            "independent_endpoint": {
              "type": "integer",
              "minimum": 0
            },
            "controller": {
              "type": "integer",
              "minimum": 0
            },
            "adaptive_preparation": {
              "type": "integer",
              "minimum": 0
            },
            "adaptive_audit": {
              "type": "integer",
              "minimum": 0
            },
            "adaptive_probe": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": []
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "enabled",
        "profile",
        "device_buffer_limit_bytes",
        "dual",
        "iterations",
        "assessment_iteration",
        "restarts",
        "kernel_launches",
        "device_buffer_peak_bytes",
        "phases_ns",
        "unavailable"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "missing_candidate",
            "certified_success",
            "feasible_unclosed",
            "missing_certificate",
            "numerical_rejection",
            "interrupted",
            "timeout",
            "work_limit",
            "unsupported",
            "backend_failure",
            "reference_only"
          ]
        },
        "feasible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "objective": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "gap_upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "gap_closed": {
          "type": "boolean"
        },
        "allowance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "repaired": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "classification",
        "feasible",
        "objective",
        "bound",
        "gap_upper",
        "gap_closed",
        "allowance",
        "repaired",
        "reason"
      ]
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logical_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "physical_iterations": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "assessments": {
          "type": "integer",
          "minimum": 0
        },
        "kkt_evaluations": {
          "type": "integer",
          "minimum": 0
        },
        "restarts": {
          "type": "integer",
          "minimum": 0
        },
        "controller": {
          "const": "host-restart-weight-v1"
        },
        "weight": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1000000.0
        },
        "stop": {
          "enum": [
            "accepted",
            "iteration_limit",
            "interrupted",
            "time_limit",
            "device_failure",
            "numerical_failure"
          ]
        },
        "device_kernel_launches": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "logical_iterations",
        "physical_iterations",
        "assessments",
        "kkt_evaluations",
        "restarts",
        "controller",
        "weight",
        "stop",
        "device_kernel_launches"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settings": {
          "$ref": "lp-execution-v1.schema.json"
        },
        "code_object_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "allocations": {
          "type": "integer",
          "minimum": 0
        },
        "allocated_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "upload_calls": {
          "type": "integer",
          "minimum": 0
        },
        "upload_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "readback_calls": {
          "type": "integer",
          "minimum": 0
        },
        "readback_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "synchronizations": {
          "type": "integer",
          "minimum": 0
        },
        "kernel_launches": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "settings",
        "code_object_sha256",
        "allocations",
        "allocated_bytes",
        "upload_calls",
        "upload_bytes",
        "readback_calls",
        "readback_bytes",
        "synchronizations",
        "kernel_launches"
      ]
    },
    "adaptive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "adaptive-fp32-fp64-v1"
        },
        "settings": {
          "$ref": "lp-adaptive-v1.schema.json"
        },
        "proposed_steps": {
          "type": "integer",
          "minimum": 0
        },
        "audit_steps": {
          "type": "integer",
          "minimum": 0
        },
        "probe_steps": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_steps": {
          "type": "integer",
          "minimum": 0
        },
        "replay_steps": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_windows": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_windows": {
          "type": "integer",
          "minimum": 0
        },
        "rung_proposals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "unavailable_rungs": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "iteration": {
                "type": "integer",
                "minimum": 0
              },
              "physical_work": {
                "type": "integer",
                "minimum": 0
              },
              "from": {
                "enum": [
                  "working_fp32",
                  "accumulation_fp32",
                  "products_fp32",
                  "storage_fp32",
                  "fp64"
                ]
              },
              "to": {
                "anyOf": [
                  {
                    "enum": [
                      "working_fp32",
                      "accumulation_fp32",
                      "products_fp32",
                      "storage_fp32",
                      "fp64"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "enum": [
                  "preparation_guard",
                  "range_guard",
                  "audit_failed",
                  "reference_guard",
                  "demotion"
                ]
              }
            },
            "required": [
              "iteration",
              "physical_work",
              "from",
              "to",
              "reason"
            ]
          }
        },
        "final_rung": {
          "enum": [
            "working_fp32",
            "accumulation_fp32",
            "products_fp32",
            "storage_fp32",
            "fp64"
          ]
        },
        "step": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_audit_error": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "method",
        "settings",
        "proposed_steps",
        "audit_steps",
        "probe_steps",
        "rejected_steps",
        "replay_steps",
        "accepted_windows",
        "rejected_windows",
        "rung_proposals",
        "unavailable_rungs",
        "transitions",
        "final_rung",
        "step",
        "max_audit_error"
      ]
    }
  },
  "required": [
    "schema_version",
    "model_sha256",
    "requested_backend",
    "record",
    "row_ids",
    "diagnostics",
    "assessment",
    "fallback_reason",
    "payload_sha256",
    "execution",
    "adaptive"
  ]
}
