{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lp-manifest-v1.schema.json",
  "title": "LP manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "partition": {
      "enum": [
        "development",
        "validation",
        "held_out"
      ]
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "enum": [
              "scheduling",
              "irregular",
              "dense_block",
              "scaling",
              "small",
              "taillard_diagnostic"
            ]
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          },
          "witness": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "generator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "const": 1
              },
              "seed": {
                "type": "integer",
                "minimum": 0
              },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "size": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "required": [
                  "size"
                ]
              }
            },
            "required": [
              "name",
              "version",
              "seed",
              "parameters"
            ]
          }
        },
        "required": [
          "id",
          "family",
          "group",
          "model",
          "bytes",
          "witness",
          "source",
          "license",
          "generator"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "partition",
    "instances"
  ]
}
