{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "record_id",
    "manifest",
    "revision",
    "dirty",
    "hardware",
    "toolchain",
    "configuration",
    "timing",
    "status",
    "objective",
    "warnings",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "example",
        "measured"
      ]
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dirty": {
      "type": "boolean"
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "cpu",
        "logical_cpus",
        "gpu_uuid",
        "gpu_name",
        "driver"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "logical_cpus": {
          "type": "integer",
          "minimum": 1
        },
        "gpu_uuid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^GPU-[A-Za-z0-9-]+$"
        },
        "gpu_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "driver": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rustc",
        "cargo"
      ],
      "properties": {
        "rustc": {
          "type": "string",
          "minLength": 1
        },
        "cargo": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "configuration": {
      "$ref": "run-config-v1.schema.json"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "includes",
        "elapsed_ns",
        "samples"
      ],
      "properties": {
        "clock": {
          "const": "monotonic"
        },
        "includes": {
          "const": "end-to-end-with-transfers"
        },
        "elapsed_ns": {
          "type": "integer",
          "minimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "status": {
      "enum": [
        "smoke_passed",
        "feasible",
        "infeasible",
        "unbounded",
        "interrupted",
        "time_limited",
        "backend_failure",
        "unsupported"
      ]
    },
    "objective": {
      "type": [
        "number",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "smoke_passed",
              "infeasible",
              "unbounded",
              "backend_failure",
              "unsupported"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "objective": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "backend_failure"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
