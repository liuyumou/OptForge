{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "witness": {
      "$ref": "lp-external-witness-v1.schema.json"
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "missing_candidate",
            "certified_success",
            "feasible_unclosed",
            "missing_certificate",
            "numerical_rejection",
            "interrupted",
            "timeout",
            "work_limit",
            "unsupported",
            "backend_failure",
            "reference_only"
          ]
        },
        "feasible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "objective": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "gap_upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "gap_closed": {
          "type": "boolean"
        },
        "allowance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "repaired": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "classification",
        "feasible",
        "objective",
        "bound",
        "gap_upper",
        "gap_closed",
        "allowance",
        "repaired",
        "reason"
      ]
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "witness",
    "assessment",
    "payload_sha256"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lp-external-endpoint-v1.schema.json"
}
