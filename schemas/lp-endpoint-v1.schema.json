{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lp-endpoint-v1.schema.json",
  "title": "LP endpoint v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requested_backend": {
      "enum": [
        "highs",
        "host-lp",
        "cuda-lp"
      ]
    },
    "record": {
      "$ref": "solve-record-v2.schema.json"
    },
    "row_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "const": true
        },
        "profile": {
          "type": "boolean"
        },
        "device_buffer_limit_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "dual": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "iterations": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "assessment_iteration": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "restarts": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "kernel_launches": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "device_buffer_peak_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "phases_ns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_preparation": {
              "type": "integer",
              "minimum": 0
            },
            "device_context": {
              "type": "integer",
              "minimum": 0
            },
            "preparation": {
              "type": "integer",
              "minimum": 0
            },
            "preconditioning": {
              "type": "integer",
              "minimum": 0
            },
            "invariant_allocation_upload": {
              "type": "integer",
              "minimum": 0
            },
            "working_allocation": {
              "type": "integer",
              "minimum": 0
            },
            "working_upload": {
              "type": "integer",
              "minimum": 0
            },
            "kernels_and_synchronization": {
              "type": "integer",
              "minimum": 0
            },
            "readback": {
              "type": "integer",
              "minimum": 0
            },
            "iteration": {
              "type": "integer",
              "minimum": 0
            },
            "host_checks": {
              "type": "integer",
              "minimum": 0
            },
            "solve_record_serialization": {
              "type": "integer",
              "minimum": 0
            },
            "native_preparation": {
              "type": "integer",
              "minimum": 0
            },
            "native_solve": {
              "type": "integer",
              "minimum": 0
            },
            "native_extraction": {
              "type": "integer",
              "minimum": 0
            },
            "independent_endpoint": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": []
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "enabled",
        "profile",
        "device_buffer_limit_bytes",
        "dual",
        "iterations",
        "assessment_iteration",
        "restarts",
        "kernel_launches",
        "device_buffer_peak_bytes",
        "phases_ns",
        "unavailable"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "missing_candidate",
            "certified_success",
            "feasible_unclosed",
            "missing_certificate",
            "numerical_rejection",
            "interrupted",
            "timeout",
            "work_limit",
            "unsupported",
            "backend_failure",
            "reference_only"
          ]
        },
        "feasible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "objective": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "gap_upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "gap_closed": {
          "type": "boolean"
        },
        "allowance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "repaired": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "classification",
        "feasible",
        "objective",
        "bound",
        "gap_upper",
        "gap_closed",
        "allowance",
        "repaired",
        "reason"
      ]
    },
    "fallback_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "model_sha256",
    "requested_backend",
    "record",
    "row_ids",
    "diagnostics",
    "assessment",
    "fallback_reason",
    "payload_sha256"
  ]
}
