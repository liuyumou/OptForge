{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conformance record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extension_id",
    "version",
    "host_contract_version",
    "grid_size",
    "backend_version",
    "checks",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "extension_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "host_contract_version": {
      "type": "integer",
      "minimum": 0
    },
    "grid_size": {
      "type": "integer",
      "minimum": 1
    },
    "backend_version": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed",
          "detail"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "outcome": {
      "type": "boolean"
    }
  }
}
