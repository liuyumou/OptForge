{
  "$id": "lp-adaptive-cost-trial-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "config_id": {
            "const": "baseline-direct"
          }
        }
      },
      "then": {
        "properties": {
          "adaptive": {
            "const": {
              "audit_interval": 32,
              "demotion": null,
              "dual_absolute": 1e-07,
              "ladder": [
                "accumulation_fp32",
                "fp64"
              ],
              "primal_absolute": 1e-07,
              "relative": 1e-07,
              "schema_version": 1
            }
          },
          "policy_id": {
            "const": "direct"
          },
          "variant": {
            "const": "baseline"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config_id": {
            "const": "repaired-direct"
          }
        }
      },
      "then": {
        "properties": {
          "adaptive": {
            "const": {
              "audit_interval": 32,
              "demotion": null,
              "dual_absolute": 1e-07,
              "ladder": [
                "accumulation_fp32",
                "fp64"
              ],
              "primal_absolute": 1e-07,
              "relative": 1e-07,
              "schema_version": 1
            }
          },
          "policy_id": {
            "const": "direct"
          },
          "variant": {
            "const": "repaired"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config_id": {
            "const": "baseline-gradual"
          }
        }
      },
      "then": {
        "properties": {
          "adaptive": {
            "const": {
              "audit_interval": 32,
              "demotion": {
                "clean_windows": 4,
                "margin_fraction": 0.25
              },
              "dual_absolute": 1e-07,
              "ladder": [
                "working_fp32",
                "accumulation_fp32",
                "products_fp32",
                "storage_fp32",
                "fp64"
              ],
              "primal_absolute": 1e-07,
              "relative": 1e-07,
              "schema_version": 1
            }
          },
          "policy_id": {
            "const": "gradual"
          },
          "variant": {
            "const": "baseline"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config_id": {
            "const": "repaired-gradual"
          }
        }
      },
      "then": {
        "properties": {
          "adaptive": {
            "const": {
              "audit_interval": 32,
              "demotion": {
                "clean_windows": 4,
                "margin_fraction": 0.25
              },
              "dual_absolute": 1e-07,
              "ladder": [
                "working_fp32",
                "accumulation_fp32",
                "products_fp32",
                "storage_fp32",
                "fp64"
              ],
              "primal_absolute": 1e-07,
              "relative": 1e-07,
              "schema_version": 1
            }
          },
          "policy_id": {
            "const": "gradual"
          },
          "variant": {
            "const": "repaired"
          }
        }
      }
    }
  ],
  "properties": {
    "activity": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "path": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "activity_wait_ns": {
      "anyOf": [
