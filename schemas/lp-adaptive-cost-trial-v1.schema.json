        },
        {
          "type": "null"
        }
      ]
    },
    "endpoint": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "path": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
