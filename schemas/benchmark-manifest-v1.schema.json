{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "purpose",
    "suite",
    "split",
    "license",
    "instances",
    "seeds",
    "configuration",
    "timing"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "enum": [
        "bootstrap-smoke",
        "correctness",
        "performance"
      ]
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "development",
        "validation",
        "held-out"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "source",
          "generator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "generator": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "seed",
                  "parameters"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "parameters": {
                    "type": "object"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "configuration": {
      "$ref": "run-config-v1.schema.json"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "includes",
        "warmup_runs",
        "measured_runs"
      ],
      "properties": {
        "clock": {
          "const": "monotonic"
        },
        "includes": {
          "const": "end-to-end-with-transfers"
        },
        "warmup_runs": {
          "type": "integer",
          "minimum": 0
        },
        "measured_runs": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
