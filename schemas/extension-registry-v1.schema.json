{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extension registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "extension_id",
          "version",
          "license",
          "category",
          "authority_basis",
          "host_contract_version",
          "problem_classes",
          "deterministic",
          "limits",
          "data_requirement",
          "hardware_requirement",
          "requires",
          "conflicts_with",
          "promotion"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "extension_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "category": {
            "enum": [
              "candidate_producer",
              "search_adviser",
              "transformation"
            ]
          },
          "authority_basis": {
            "enum": [
              "propose_validated_candidate",
              "propose_checked_action"
            ]
          },
          "host_contract_version": {
            "type": "integer",
            "minimum": 0
          },
          "problem_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "continuous",
                "discrete"
              ]
            }
          },
          "deterministic": {
            "type": "boolean"
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_invocations",
              "max_proposals"
            ],
            "properties": {
              "max_invocations": {
                "type": "integer",
                "minimum": 1
              },
              "max_proposals": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "data_requirement": {
            "enum": [
              "none",
              "flow_shop_instance"
            ]
          },
          "hardware_requirement": {
            "enum": [
              "cpu",
              "gpu"
            ]
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "conflicts_with": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "promotion": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "const": "experimental"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "conformance_path",
                  "conformance_sha256"
                ],
                "properties": {
                  "state": {
                    "const": "promoted"
                  },
                  "conformance_path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "conformance_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
