{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lp-trial-v4.schema.json",
  "title": "GPUP-5 precision and external trial",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 4
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_id": {
      "enum": [
        "reference-matched",
        "tuned-fp64",
        "precision-fp64",
        "storage-fp32",
        "products-fp32",
        "accumulation-fp32",
        "master-correction32",
        "working-fp32-correction32",
        "host-lp",
        "highs",
        "copt-cpu-pdlp",
        "copt-gpu-pdlp"
      ]
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "block": {
      "type": "string",
      "minLength": 1
    },
    "repetition": {
      "type": "integer",
      "minimum": 0
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "enum": [
        "timing",
        "profile"
      ]
    },
    "requested_backend": {
      "enum": [
        "highs",
        "host-lp",
        "cuda-lp",
        "cuda-lp-matched",
        "cuda-lp-tuned",
        "copt-cpu-pdlp",
        "copt-gpu-pdlp"
      ]
    },
    "executed_backend": {
      "anyOf": [
        {
          "enum": [
            "highs",
            "host-lp",
            "cuda-lp",
            "cuda-lp-matched",
            "cuda-lp-tuned",
            "copt-cpu-pdlp",
            "copt-gpu-pdlp"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "completed",
        "timeout",
        "cancelled",
        "memory_limit",
        "process_failure",
        "invalid_evidence",
        "missing_evidence",
        "lease_timeout",
        "lease_cancelled",
        "cancelled_before_launch",
        "activity_blocked"
      ]
    },
    "endpoint_class": {
      "anyOf": [
        {
          "enum": [
            "missing_candidate",
            "certified_success",
            "feasible_unclosed",
            "missing_certificate",
            "numerical_rejection",
            "interrupted",
            "timeout",
            "work_limit",
            "unsupported",
            "backend_failure",
            "reference_only"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "endpoint": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "worker": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "stdout": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "stderr": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "elapsed_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "queue_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "leased_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "verification_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "peak_rss_bytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "memory_method": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "solve_seconds": {
          "const": 10
        },
        "cleanup_seconds": {
          "const": 2
        },
        "host_rss_bytes": {
          "const": 8589934592
        },
        "device_buffer_bytes": {
          "const": 8589934592
        },
        "poll_ms": {
          "const": 10
        },
        "output_bytes": {
          "const": 33554432
        }
      },
      "required": [
        "solve_seconds",
        "cleanup_seconds",
        "host_rss_bytes",
        "device_buffer_bytes",
        "poll_ms",
        "output_bytes"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "source_tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code_object_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "highs_library_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rustc": {
          "type": "string",
          "minLength": 1
        },
        "cargo": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "cpu_affinity": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        },
        "build_profile": {
          "enum": [
            "release",
            "debug"
          ]
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "telemetry_before": {
          "type": "string",
          "minLength": 1
        },
        "telemetry_after": {
          "type": "string",
          "minLength": 1
        },
        "schema_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "copt_library_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "copt_binding_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "revision",
        "dirty",
        "source_tree_sha256",
        "binary_sha256",
        "code_object_sha256",
        "highs_library_sha256",
        "rustc",
        "cargo",
        "os",
        "cpu",
        "cpu_affinity",
        "build_profile",
        "device",
        "telemetry_before",
        "telemetry_after",
        "schema_snapshot_sha256",
        "copt_library_sha256",
        "copt_binding_sha256"
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "budget_authority_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "activity_wait_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "activity": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "campaign_sha256",
    "instance_id",
    "model_sha256",
    "config_id",
    "config_sha256",
    "block",
    "repetition",
    "order",
    "mode",
    "requested_backend",
    "executed_backend",
    "status",
    "endpoint_class",
    "endpoint",
    "worker",
    "stdout",
    "stderr",
    "elapsed_ns",
    "queue_ns",
    "leased_ns",
    "verification_ns",
    "peak_rss_bytes",
    "memory_method",
    "limits",
    "provenance",
    "error",
    "budget_authority_sha256",
    "activity_wait_ns",
    "activity"
  ]
}
